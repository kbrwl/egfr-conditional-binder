# Structures are large and re-downloadable from RCSB by analysis/02.
data/structures/

# Bulk design output. Only the final shortlist is committed, via the exception
# below, so the repo records what we chose without carrying thousands of drafts.
# NOTE: must be "dir/*", not "dir/". A directory-level ignore stops git looking
# inside it at all, so the negations below would never take effect and the final
# shortlist would be silently excluded.
results/candidates/*
!results/candidates/shortlist.csv
!results/candidates/.gitkeep

# Structure files anywhere, including the receptor-only files written by
# analysis/02 and any design output. All are regenerable from committed code.
*.pdb
*.cif
*.ent
*.mmtf
*.pdb.gz
*.cif.gz

# Environment
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# OS noise
.DS_Store
Thumbs.db

# Internal drafts and working notes. Kept on disk, not tracked: their form implies
# they are finished documents for an outside reader, and they are neither. The
# README and the methods document get written at the end, from settled
# conclusions. The official facts they contain live in docs/rules-reference.md;
# our own reasoning lives in docs/decisions-log.md.
/README.draft.md
submission/methods.draft.md
submission/slot-plan.draft.md
docs/competition-brief.md

# Staging area for documents handed over from Claude chat. Files land here, get
# installed at their proper paths, and the staged copy is deleted in the same
# commit. Nothing is committed from here in place. See CLAUDE.md, "Documents
# handed over from Claude chat".
temp_docs_from_claude_chat/
